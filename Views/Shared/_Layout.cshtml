@inject JiraSheetBoard.Services.ISheetDataService SheetService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Jira Sheet Viewer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- 3rd Party GLightbox for high-resolution interactive screenshot viewer -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="compact-density">
    <header>
        <nav class="jira-navbar navbar navbar-expand-lg">
            <div class="container-fluid px-0">
                <a class="jira-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/jira-logo.svg" alt="Jira Logo" class="jira-brand-icon" />
                    <span>JiraSheet</span>
                </a>

                <div class="d-flex align-items-center gap-2 ms-2 me-auto">
                    <span class="jira-view-only-badge" title="Safe Read-Only Viewer (No edits permitted)">
                        <i class="bi bi-shield-check text-primary"></i> View Only
                    </span>
                    <span class="jira-badge-source text-truncate d-none d-md-inline-flex" title="Loaded Live Source">
                        <i class="bi bi-file-earmark-spreadsheet-fill"></i> @SheetService.GetCurrentSourceName()
                    </span>
                </div>

                <div class="d-flex align-items-center gap-1">
                    @if (!string.IsNullOrWhiteSpace(SheetService.GetConfiguredUrl()))
                    {
                        <a href="@SheetService.GetConfiguredUrl()" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-jira-excel" title="View live workbook in Microsoft Excel Online">
                            <i class="bi bi-file-earmark-excel-fill text-success"></i> Excel Online <i class="bi bi-box-arrow-up-right small ms-1 opacity-75"></i>
                        </a>

                        <form asp-action="Sync" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-jira-primary" title="Fetch fresh live data directly from SharePoint / Excel Online">
                                <i class="bi bi-arrow-repeat"></i> Sync Live Sheet
                            </button>
                        </form>
                    }

                    <a asp-action="ExportCsv" class="btn btn-sm btn-jira-subtle" title="Download active dataset as CSV">
                        <i class="bi bi-download"></i> Export CSV
                    </a>

                    <button type="button" class="btn btn-sm btn-jira-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#importSheetModal" title="Connect any Google Sheet, Excel Online, SharePoint or CSV link">
                        <i class="bi bi-link-45deg"></i> Connect Sheet / Paste Link
                    </button>
                </div>
            </div>
        </nav>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-2 mb-0 py-2 px-3 small" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-2 mb-0 py-2 px-3 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <main role="main">
        @RenderBody()
    </main>

    <!-- Connect / Import Google Sheet Modal -->
    <div class="modal fade" id="importSheetModal" tabindex="-1" aria-labelledby="importSheetModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header py-2 px-3 bg-light border-bottom">
                    <h6 class="modal-title fw-bold" id="importSheetModalLabel">
                        <i class="bi bi-cloud-arrow-down text-primary me-2"></i>Connect Any Sheet / Paste Link
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <p class="small text-muted mb-3">
                        Connect any public cloud spreadsheet link. The board will automatically parse cards, workflow columns, assignees, priorities, and screenshot attachments into a live Jira Kanban board.
                    </p>

                    <ul class="nav nav-tabs mb-3" id="importTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold small" id="url-tab" data-bs-toggle="tab" data-bs-target="#tab-url" type="button" role="tab">
                                <i class="bi bi-link-45deg me-1"></i> Paste Sheet URL
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold small" id="upload-tab" data-bs-toggle="tab" data-bs-target="#tab-upload" type="button" role="tab">
                                <i class="bi bi-upload me-1"></i> Upload File (.xlsx, .csv)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold small" id="paste-tab" data-bs-toggle="tab" data-bs-target="#tab-paste" type="button" role="tab">
                                <i class="bi bi-clipboard me-1"></i> Paste Copied Rows
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="importTabContent">
                        <!-- Tab 1: Sheet URL -->
                        <div class="tab-pane fade show active" id="tab-url" role="tabpanel">
                            <form asp-action="Import" method="post" id="importUrlForm">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Google Sheet, Excel Online, SharePoint or CSV Public Link</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light"><i class="bi bi-link-45deg"></i></span>
                                        <input type="url" 
                                               name="GoogleSheetUrl" 
                                               id="modalSheetUrlInput" 
                                               class="form-control" 
                                               value="@(SheetService.GetConfiguredUrl() ?? "")" 
                                               placeholder="https://docs.google.com/spreadsheets/d/... or SharePoint / Excel Online / CSV link" 
                                               required />
                                        <button type="button" class="btn btn-outline-secondary" id="pasteClipboardBtn" title="Paste link from clipboard">
                                            <i class="bi bi-clipboard"></i> Paste
                                        </button>
                                    </div>

                                    <div class="mt-2 d-flex flex-wrap gap-1">
                                        <span class="badge bg-light text-secondary border font-monospace small"><i class="bi bi-google text-primary me-1"></i> Google Sheets</span>
                                        <span class="badge bg-light text-secondary border font-monospace small"><i class="bi bi-file-earmark-excel text-success me-1"></i> Excel Online / SharePoint</span>
                                        <span class="badge bg-light text-secondary border font-monospace small"><i class="bi bi-filetype-csv text-info me-1"></i> Direct CSV / XLSX URLs</span>
                                    </div>

                                    <div class="small text-muted mt-2 ps-1 border-start border-2 border-primary">
                                        <i class="bi bi-info-circle text-primary me-1"></i> <strong>Tip:</strong> Ensure your Google Sheet has <em>"General access: Anyone with the link can view"</em> (or <em>File &gt; Share &gt; Publish to web &gt; CSV</em>).
                                    </div>
                                    
                                    @if (!string.IsNullOrWhiteSpace(SheetService.GetConfiguredUrl()))
                                    {
                                        <div class="alert alert-info py-1 px-2 small mt-2 mb-0 d-flex align-items-center justify-content-between">
                                            <span class="text-truncate me-2"><i class="bi bi-link-45deg me-1"></i> Active Link: <strong>@SheetService.GetConfiguredUrl()</strong></span>
                                            <span class="badge bg-success">Configured</span>
                                        </div>
                                    }
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" id="fetchSheetSubmitBtn" class="btn btn-sm btn-jira-primary fw-semibold">
                                        <i class="bi bi-cloud-download me-1"></i> Fetch & Load Sheet
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Tab 2: File Upload -->
                        <div class="tab-pane fade" id="tab-upload" role="tabpanel">
                            <form asp-action="Import" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Choose Excel (.xlsx) or CSV (.csv)</label>
                                    <input type="file" name="UploadFile" class="form-control form-control-sm" accept=".xlsx,.csv,.txt" required />
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-sm btn-jira-primary">
                                        <i class="bi bi-upload me-1"></i> Upload & Render
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Tab 3: Paste Data -->
                        <div class="tab-pane fade" id="tab-paste" role="tabpanel">
                            <form asp-action="Import" method="post">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Paste copied rows (TSV or CSV)</label>
                                    <textarea name="RawData" class="form-control form-control-sm font-monospace" rows="6" placeholder="Bug no.	Title	Status	Priority..." required></textarea>
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-sm btn-jira-primary">
                                        <i class="bi bi-check2-circle me-1"></i> Parse & Display
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Jira Issue Detail Modal (Compact, Read-Only, Rich Presentation) -->
    <div class="modal fade" id="issueDetailModal" tabindex="-1" aria-labelledby="issueDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow">
                <div class="modal-jira-header py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span id="modalTypeBadge" class="jira-type-icon jira-type-bug">Bug</span>
                        <span id="modalIssueKey" class="jira-issue-key fs-6">BUG-000</span>
                        <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-2" id="copyKeyBtn" title="Copy Key to clipboard">
                            <i class="bi bi-clipboard"></i> Copy Key
                        </button>
                        <span class="jira-view-only-badge py-0 px-2 small"><i class="bi bi-eye"></i> Read Only</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body modal-jira-body p-3">
                    <div class="row g-3">
                        <!-- Left Main Column (Details, Screenshots, QA) -->
                        <div class="col-lg-8 pe-lg-3">
                            <!-- Title -->
                            <h5 id="modalIssueTitle" class="fw-bold text-dark mb-3">Issue Title</h5>

                            <!-- Attached Screenshots (with GLightbox 3rd-party zoom/pan) -->
                            <div id="modalPhotoSection" class="mb-3">
                                <div class="jira-detail-section-title d-flex align-items-center justify-content-between">
                                    <span><i class="bi bi-images text-primary me-1"></i> Attached Screenshots</span>
                                    <span id="modalPhotoCountBadge" class="badge bg-light text-muted border">0 photos</span>
                                </div>
                                <div class="jira-hero-photo-wrapper text-center">
                                    <a id="modalHeroPhotoLink" href="" class="glightbox-hero" data-gallery="issue-gallery">
                                        <img id="modalHeroPhoto" src="" alt="Screenshot" class="jira-detail-hero-photo img-fluid rounded" />
                                        <div class="jira-photo-zoom-overlay">
                                            <i class="bi bi-arrows-fullscreen"></i> Click for Fullscreen HD Lightbox
                                        </div>
                                    </a>
                                </div>
                                <div id="modalThumbnailsContainer" class="jira-detail-thumbnails mt-2"></div>
                            </div>

                            <!-- Description -->
                            <div class="mb-3">
                                <div class="jira-detail-section-title">
                                    <i class="bi bi-text-paragraph text-primary me-1"></i> Description
                                </div>
                                <div id="modalDescription" class="jira-description-box p-2 bg-light rounded border text-dark small">
                                    No description provided.
                                </div>
                            </div>

                            <!-- QA Bug Reproduction Section -->
                            <div class="mb-3" id="modalQADetailsSection">
                                <div class="jira-detail-section-title">
                                    <i class="bi bi-shield-check text-success me-1"></i> QA Reproduction & Verification
                                </div>
                                <div class="card bg-white border p-3 shadow-none">
                                    <div class="mb-2">
                                        <div class="small fw-bold text-dark mb-1"><i class="bi bi-list-ol text-primary me-1"></i> Steps to Reproduce:</div>
                                        <div id="modalStepsView" class="small text-secondary ps-3 border-start border-2 border-primary" style="white-space: pre-wrap;">-</div>
                                    </div>
                                    <div class="row g-2 mt-1">
                                        <div class="col-md-6">
                                            <div class="p-2 rounded bg-danger-subtle border border-danger-subtle">
                                                <div class="small fw-bold text-danger mb-1"><i class="bi bi-x-circle me-1"></i> Actual Result:</div>
                                                <div id="modalActualView" class="small text-dark" style="white-space: pre-wrap;">-</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="p-2 rounded bg-success-subtle border border-success-subtle">
                                                <div class="small fw-bold text-success mb-1"><i class="bi bi-check-circle me-1"></i> Expected Result:</div>
                                                <div id="modalExpectedView" class="small text-dark" style="white-space: pre-wrap;">-</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-2" id="modalCommentsContainer">
                                        <div class="small fw-bold text-muted mb-1"><i class="bi bi-chat-left-dots text-secondary me-1"></i> Comments:</div>
                                        <div id="modalCommentsView" class="small text-muted fst-italic" style="white-space: pre-wrap;">-</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Custom Fields from Sheet -->
                            <div class="mb-2">
                                <div class="jira-detail-section-title">
                                    <i class="bi bi-columns-gap text-primary me-1"></i> Sheet Attributes
                                </div>
                                <div id="modalCustomFields" class="row g-2"></div>
                            </div>
                        </div>

                        <!-- Right Sidebar Column (Jira Metadata) -->
                        <div class="col-lg-4 border-start ps-lg-3 pt-2 pt-lg-0">
                            <div class="jira-sidebar-card bg-light p-2 rounded border">
                                <!-- Status -->
                                <div class="jira-sidebar-field mb-2">
                                    <div class="jira-sidebar-label">Status</div>
                                    <span id="modalStatusBadge" class="badge-status badge-status-todo">To Do</span>
                                </div>

                                <!-- Assignee -->
                                <div class="jira-sidebar-field mb-2">
                                    <div class="jira-sidebar-label">Assignee / Developer</div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span id="modalAssigneeAvatar" class="jira-avatar-circle">?</span>
                                        <span id="modalAssigneeName" class="fw-semibold text-dark small">Unassigned</span>
                                    </div>
                                </div>

                                <!-- Priority -->
                                <div class="jira-sidebar-field mb-2">
                                    <div class="jira-sidebar-label">Priority</div>
                                    <div id="modalPriority" class="fw-semibold small">Medium</div>
                                </div>

                                <!-- Reporter -->
                                <div class="jira-sidebar-field mb-2">
                                    <div class="jira-sidebar-label">Reporter</div>
                                    <div id="modalReporterName" class="text-secondary small">QA Team</div>
                                </div>

                                <!-- Created Date -->
                                <div class="jira-sidebar-field mb-2">
                                    <div class="jira-sidebar-label">Created Date</div>
                                    <div id="modalCreatedDate" class="text-secondary small">-</div>
                                </div>

                                <!-- Due Date -->
                                <div class="jira-sidebar-field mb-2">
                                    <div class="jira-sidebar-label">Due Date</div>
                                    <div id="modalDueDate" class="text-secondary small">-</div>
                                </div>

                                <!-- Tags -->
                                <div class="jira-sidebar-field mb-1">
                                    <div class="jira-sidebar-label">Module / Feature Tags</div>
                                    <div id="modalTagsContainer" class="d-flex flex-wrap gap-1"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer py-2 px-3 bg-light d-flex justify-content-end">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Jira Action Toast Notification -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1099;">
        <div id="jiraToast" class="toast align-items-center text-white bg-dark border-0 shadow-sm" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2 py-2">
                    <i id="jiraToastIcon" class="bi bi-check-circle-fill text-success fs-6"></i>
                    <span id="jiraToastMsg" class="small">Action completed successfully.</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <!-- 3rd Party GLightbox JS -->
    <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
